training/runs/
*.cache
training/dataset/images/*/*
!training/dataset/images/*/.gitkeep
training/dataset/labels/*/*
!training/dataset/labels/*/.gitkeep
training/dataset/debug_vis/

# ROS 2 build artifacts
build/
install/
log/

# Docker
.dockerignore

# OS files
.DS_Store
Thumbs.db
