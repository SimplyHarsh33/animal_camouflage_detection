<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="animal_world">
    <!-- Sun light source with natural daylight angles -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 1. Realistic 3D Camouflaged Deer (Forward-Left) -->
    <include>
      <name>deer</name>
      <uri>model://deer</uri>
      <static>true</static>
      <pose>4.2 1.8 0 0 0 -2.2</pose>
    </include>

    <!-- 2. Realistic 3D Camouflaged Fox (Forward-Right near rock) -->
    <include>
      <name>fox</name>
      <uri>model://fox</uri>
      <static>true</static>
      <pose>3.0 -1.2 0 0 0 2.3</pose>
    </include>

    <!-- 3. Realistic 3D Camouflaged Rabbit (Close ground-level target) -->
    <include>
      <name>rabbit</name>
      <uri>model://rabbit</uri>
      <static>true</static>
      <pose>2.2 0.7 0 0 0 -1.2</pose>
    </include>

    <!-- 4. Realistic 3D Predator (Leopard/Cat in central field of view) -->
    <include>
      <name>leopard</name>
      <uri>model://leopard</uri>
      <static>true</static>
      <pose>4.8 -0.2 0 0 0 3.1415</pose>
    </include>

    <!-- 5. Natural Environment: Rocks for Camouflage Concealment -->
    <include>
      <name>rock_fox_cover</name>
      <uri>model://rock</uri>
      <static>true</static>
      <pose>3.3 -1.5 0 0 0 0.6</pose>
    </include>

    <include>
      <name>rock_deer_cover</name>
      <uri>model://rock</uri>
      <static>true</static>
      <pose>4.6 2.3 0 0 0 -0.8</pose>
    </include>

    <!-- 6. Natural Environment: Oak & Pine Trees -->
    <include>
      <name>oak_tree_left</name>
      <uri>model://oak_tree</uri>
      <static>true</static>
      <pose>6.5 3.2 0 0 0 0</pose>
    </include>

    <include>
      <name>pine_tree_right</name>
      <uri>model://pine_tree</uri>
      <static>true</static>
      <pose>7.0 -2.8 0 0 0 0.5</pose>
    </include>

    <!-- 7. Background Human Reference -->
    <include>
      <name>standing_person</name>
      <uri>model://person_standing</uri>
      <static>true</static>
      <pose>6.0 -4.0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
