<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="deer_camouflage_world">

    <!-- ===== ENVIRONMENT ===== -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ===== DEER: 3 Strategic Camouflage Scenarios ===== -->

    <!--
      Scenario 1: CLOSE RANGE (3.0 m)
      Deer standing in partial profile near tree line and rocks.
      Expected: Clear visual silhouette, testing baseline detection.
    -->
    <include>
      <name>deer_close</name>
      <uri>model://deer</uri>
      <static>true</static>
      <pose>3.0 0.0 0 0 0 3.1415</pose>
    </include>

    <!-- Rock cover for close scenario -->
    <include>
      <name>rock_close_cover</name>
      <uri>model://rock</uri>
      <static>true</static>
      <pose>3.4 0.6 0 0 0 0.8</pose>
    </include>

    <!--
      Scenario 2: MEDIUM RANGE (5.5 m) — Forward-Left
      Deer grazing among oak trees, dappled light and bark concealment.
      Expected: Moderate camouflage challenge.
    -->
    <include>
      <name>deer_medium</name>
      <uri>model://deer</uri>
      <static>true</static>
      <pose>5.5 2.2 0 0 0 -2.0</pose>
    </include>

    <include>
      <name>oak_tree_medium</name>
      <uri>model://oak_tree</uri>
      <static>true</static>
      <pose>5.0 3.0 0 0 0 0</pose>
    </include>

    <include>
      <name>rock_medium_cover</name>
      <uri>model://rock</uri>
      <static>true</static>
      <pose>5.9 2.8 0 0 0 -0.5</pose>
    </include>

    <!--
      Scenario 3: LONG RANGE (8.5 m) — Forward-Right
      Deer partially concealed within dense pine grove and boulders.
      Expected: High camouflage challenge against earthy backdrop.
    -->
    <include>
      <name>deer_far</name>
      <uri>model://deer</uri>
      <static>true</static>
      <pose>8.5 -2.5 0 0 0 2.5</pose>
    </include>

    <include>
      <name>pine_tree_far_1</name>
      <uri>model://pine_tree</uri>
      <static>true</static>
      <pose>9.2 -2.0 0 0 0 0.7</pose>
    </include>

    <include>
      <name>rock_far_cover_1</name>
      <uri>model://rock</uri>
      <static>true</static>
      <pose>8.8 -1.8 0 0 0 0.3</pose>
    </include>

    <include>
      <name>rock_far_cover_2</name>
      <uri>model://rock</uri>
      <static>true</static>
      <pose>8.1 -3.2 0 0 0 -1.1</pose>
    </include>

    <!-- ===== BACKGROUND HABITAT PROPS ===== -->
    <include>
      <name>oak_tree_bg_left</name>
      <uri>model://oak_tree</uri>
      <static>true</static>
      <pose>11.0 4.5 0 0 0 0.4</pose>
    </include>

    <include>
      <name>pine_tree_bg_right</name>
      <uri>model://pine_tree</uri>
      <static>true</static>
      <pose>11.5 -4.8 0 0 0 -0.6</pose>
    </include>

  </world>
</sdf>
