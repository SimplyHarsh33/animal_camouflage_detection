<?xml version="1.0" ?>
<robot name="animal_robot">
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.203125 0.23828125 0.28515625 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.80078125 0.12890625 0.1328125 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <gazebo reference="chassis">
    <material>Gazebo/Red</material>
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
  </gazebo>

  <gazebo reference="left_wheel">
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <minDepth>0.005</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="right_wheel">
    <kp>100000.0</kp>
    <kd>10.0</kd>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <minDepth>0.005</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- differential drive plugin -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="differential_drive_controller">
      <ros>
        <namespace>/animal_robot</namespace>
      </ros>

      <!-- update rate -->
      <update_rate>50</update_rate>

      <!-- wheels -->
      <left_joint>joint_right_wheel</left_joint>
      <right_joint>joint_left_wheel</right_joint>

      <!-- kinematics -->
      <wheel_separation>0.12</wheel_separation>
      <wheel_diameter>0.07</wheel_diameter>

      <!-- limits -->
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <!-- output -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>chassis</robot_base_frame>
    </plugin>
  </gazebo>

  <link name="base_link"></link>
  
  <link name="chassis">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
      <mass value="3.0"/>
      <origin rpy="0 0 0" xyz="0 0 -0.02"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.020"/>
    </inertial>
    <collision name="collision_chassis">
      <geometry>
        <box size="0.22 0.12 0.06"/>
      </geometry>
    </collision>
    <visual name="visual_chassis">
      <geometry>
        <box size="0.22 0.12 0.06"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="base_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <!-- STABLE FORWARD-FACING CAMERA -->
  <link name='rgb_cam_camera_link'>
    <inertial>
      <mass value="0.05"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="rgb_cam_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.09 0.0 0.08"/>
    <parent link="chassis"/>
    <child link="rgb_cam_camera_link"/>
  </joint>

  <link name="rgb_cam_camera_link_frame"></link>

  <joint name="rgb_cam_camera_frame_joint" type="fixed">
    <origin xyz="0.01 0 0" rpy="0 0 0" />
    <parent link="rgb_cam_camera_link" />
    <child link="rgb_cam_camera_link_frame" />
    <axis xyz="0 0 0"/>
  </joint>

  <gazebo reference="rgb_cam_camera_link_frame">
    <sensor type="camera" name="rgb_cam">
      <always_on>1</always_on>
      <update_rate>15.0</update_rate>
      <camera name="rgb_cam">
        <pose>0 0 0 0 0 0</pose>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>25.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>image_raw:=/rgb_cam/image_raw</remapping>
          <remapping>camera_info:=/rgb_cam/camera_info</remapping>
        </ros>
        <camera_name>rgb_cam</camera_name>
        <frame_name>rgb_cam_camera_link_frame</frame_name>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <link name="right_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
    </inertial>
    <collision name="link_right_wheel_collision">
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
    </collision>
    <visual name="link_right_wheel_visual">
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint_right_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="-0.05 0.06 -0.025"/>
    <child link="right_wheel"/>
    <parent link="chassis"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="20.0" velocity="20.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <link name="left_wheel">
    <inertial>
      <mass value="0.3"/>
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0002"/>
    </inertial>
    <collision name="link_left_wheel_collision">
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
    </collision>
    <visual name="link_left_wheel_visual">
      <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.035"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="joint_left_wheel" type="continuous">
    <origin rpy="0 0 0" xyz="-0.05 -0.06 -0.025"/>
    <child link="left_wheel"/>
    <parent link="chassis"/>
    <axis rpy="0 0 0" xyz="0 1 0"/>
    <limit effort="20.0" velocity="20.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- STABILIZED FRONT CASTER BALL -->
  <link name="front_pitch_link">
    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <collision name="front_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
    <visual name="front_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="front_pitch_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.08 0 -0.045"/>
    <parent link="chassis"/>
    <child link="front_pitch_link"/>
  </joint>

  <gazebo reference="front_pitch_link">
    <kp>50000.0</kp>
    <kd>20.0</kd>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
    <minDepth>0.005</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Green</material>
  </gazebo>
  
</robot>
