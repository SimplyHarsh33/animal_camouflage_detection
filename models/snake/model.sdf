<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="snake">
    <static>true</static>
    <link name="body">
      <!-- TAIL TIP -->
      <visual name="tail_visual">
        <pose>-0.28 -0.18 0.02 0 1.57 0.8</pose>
        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <uri>model://snake/materials/scripts</uri>
            <uri>model://snake/materials/textures</uri>
            <name>Animal/Snake</name>
          </script>
        </material>
      </visual>

      <!-- BODY SEGMENT 1 -->
      <visual name="body1_visual">
        <pose>-0.16 -0.10 0.035 0 1.57 0.5</pose>
