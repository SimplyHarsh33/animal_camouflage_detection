          </cylinder>
        </geometry>
        <material>
          <script>
            <uri>model://snake/materials/scripts</uri>
            <uri>model://snake/materials/textures</uri>
            <name>Animal/Snake</name>
          </script>
        </material>
      </visual>

      <!-- BODY SEGMENT 4 -->
      <visual name="body4_visual">
        <pose>0.22 0.08 0.05 0 1.57 -0.8</pose>
        <geometry>
          <cylinder>
